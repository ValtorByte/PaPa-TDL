# Optional environment overrides; use papa-tdl setup to save normal settings.
TDL_DESTINATION=drive
TDL_GROUP_NAME=TDL
# TDL_DATA_DIR=/home/YOUR_USER/.local/share/papa-tdl
# Absolute output directory; must be writable by the runtime user.
# TDL_OUTPUT_DIR=/srv/telegram-files
TDL_POLL_SECONDS=10
# 0 = unlimited, subject to disk space and provider limits.
TDL_MAX_DOWNLOAD_BYTES=0
# Optional Drive folder ID; blank uses the app-created TDL folder.
GOOGLE_DRIVE_FOLDER_ID=
